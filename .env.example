APP_ENV=development
LOG_LEVEL=INFO

# OpenAI Platform API key. Leave blank until model-backed features are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none

# Telegram values from BotFather and the webhook registration process.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS endpoint, including /webhooks/telegram. Localhost requires an HTTPS tunnel.
TELEGRAM_WEBHOOK_URL=

# Defaults for the local Supabase stack. Copy the keys printed by `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=inventory-source-artifacts

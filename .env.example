APP_ENV=development
LOG_LEVEL=INFO

# Local development dashboard. Generate the token with:
# openssl rand -hex 32
DEV_DASHBOARD_ENABLED=false
# Allows only audited, non-secret company context-setting writes.
DEV_DASHBOARD_CONFIG_WRITES_ENABLED=false
DEV_DASHBOARD_USERNAME=inventory-dev
DEV_DASHBOARD_TOKEN=
# Optional single-command API/worker supervisor. It binds only to loopback.
DEV_SUPERVISOR_ENABLED=false
DEV_SUPERVISOR_URL=http://127.0.0.1:8765
DEV_SUPERVISOR_PORT=8765
# Reuse the local dashboard token, or replace this with another generated token.
DEV_SUPERVISOR_TOKEN=${DEV_DASHBOARD_TOKEN}

# OpenAI Platform API key. Leave blank until model-backed features are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
# LLM-led Telegram text agent and its model settings.
INVENTORY_AGENT_MODEL=gpt-5.6-sol
INVENTORY_AGENT_REASONING_EFFORT=low
# Route Telegram text through the LLM-led agent. Keep false until migrations are applied.
INVENTORY_AGENT_ENABLED=false
# Bound each user/chat context. summarize retains a rolling summary; discard does not.
INVENTORY_AGENT_CONTEXT_POLICY=summarize
INVENTORY_AGENT_CONTEXT_RETENTION_DAYS=7
INVENTORY_AGENT_CONTEXT_MAX_TOKENS=30000
# Keep below the database's hard 400-item ceiling so one new tool turn always has headroom.
INVENTORY_AGENT_CONTEXT_MAX_ITEMS=300
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512

# Name matching after exact identifier lookup: semantic (default), fuzzy, or hybrid.
INVENTORY_MATCHING_STRATEGY=semantic
# Let the LLM judge retrieved candidates and ask follow-up questions when needed.
INVENTORY_CANDIDATE_JUDGING_ENABLED=true
# IANA timezone used for transaction timestamps in user-facing messages.
INVENTORY_DISPLAY_TIMEZONE=Asia/Singapore

# Telegram values from BotFather and the webhook registration process.
TELEGRAM_BOT_TOKEN=
# Username without the leading @. Required for safe natural-language group activation.
TELEGRAM_BOT_USERNAME=
# Development only: let a real admin switch to stable synthetic users with /user NAME.
TELEGRAM_DEV_USER_SIMULATION_ENABLED=false
# Inactivity window for each controller + chat selection; 5 minutes to 24 hours.
TELEGRAM_DEV_USER_SIMULATION_SESSION_MINUTES=120
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS endpoint, including /webhooks/telegram. Localhost requires an HTTPS tunnel.
TELEGRAM_WEBHOOK_URL=

# Defaults for the local Supabase stack. Copy the keys printed by `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=inventory-source-artifacts
